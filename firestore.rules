rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isChannelMember(channelId) {
      return request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.memberIds;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /channels/{channelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (request.auth.uid in resource.data.memberIds || joinsDefault());

      function joinsDefault() {
        let added = request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet());
        return resource.data.get('isDefault', false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && added == [request.auth.uid].toSet();
      }
      allow delete: if false;

      match /messages/{messageId}/{document=**} {
        allow read, write: if signedIn() && isChannelMember(channelId);
      }
    }

    match /directChats/{chatId} {
      function inChat() { return signedIn() && request.auth.uid in chatId.split('_'); }
      allow read: if inChat();
      allow create, update: if inChat()
        && request.resource.data.memberIds.toSet() == chatId.split('_').toSet();
      allow delete: if false;

      match /messages/{messageId}/{document=**} {
        allow read, write: if inChat();
      }
    }
  }
}
