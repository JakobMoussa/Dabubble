rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isChannelMember(channelId) {
      return request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.memberIds;
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // New messages must be written in the sender's own name.
    function isOwnNewMessage() {
      return request.resource.data.authorId == request.auth.uid;
    }
    // Only the author may change the text; everyone in the conversation may react or reply.
    function isAllowedMessageUpdate() {
      return (resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && changed().hasOnly(['text', 'editedAt']))
        || changed().hasOnly(['reactions', 'threadCount', 'lastThreadAt']);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /channels/{channelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (request.auth.uid in resource.data.memberIds || joinsDefault());

      function joinsDefault() {
        let added = request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet());
        return resource.data.get('isDefault', false) == true
          && changed().hasOnly(['memberIds'])
          && added == [request.auth.uid].toSet();
      }
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && isChannelMember(channelId);
        allow create: if signedIn() && isChannelMember(channelId) && isOwnNewMessage();
        allow update: if signedIn() && isChannelMember(channelId) && isAllowedMessageUpdate();
        allow delete: if false;

        match /thread/{replyId} {
          allow read: if signedIn() && isChannelMember(channelId);
          allow create: if signedIn() && isChannelMember(channelId) && isOwnNewMessage();
          allow update: if signedIn() && isChannelMember(channelId) && isAllowedMessageUpdate();
          allow delete: if false;
        }
      }
    }

    match /directChats/{chatId} {
      function inChat() { return signedIn() && request.auth.uid in chatId.split('_'); }
      allow read: if inChat();
      allow create, update: if inChat()
        && request.resource.data.memberIds.toSet() == chatId.split('_').toSet();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if inChat();
        allow create: if inChat() && isOwnNewMessage();
        allow update: if inChat() && isAllowedMessageUpdate();
        allow delete: if false;

        match /thread/{replyId} {
          allow read: if inChat();
          allow create: if inChat() && isOwnNewMessage();
          allow update: if inChat() && isAllowedMessageUpdate();
          allow delete: if false;
        }
      }
    }
  }
}
